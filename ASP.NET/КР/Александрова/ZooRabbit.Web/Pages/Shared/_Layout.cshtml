<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Ставропольский зоопарк</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
    <a class="logo" href="/">Stav-Zoo</a>
    <nav>
        <a href="/">Главная</a>
        <a href="/rabbit">Кролик</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page="/Logout" class="inline">
                <button type="submit">Выйти (@User.Identity.Name)</button>
            </form>
        }
        else { <a href="/Login">Вход</a> }
    </nav>
</header>
<main>@RenderBody()</main>
<footer>© @DateTime.Now.Year Stav-Zoo</footer>
</body>
</html>
