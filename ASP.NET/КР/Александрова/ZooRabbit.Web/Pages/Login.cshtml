@page
@model ZooRabbit.Web.Pages.LoginModel
@{ ViewData["Title"] = "Вход"; }
<h1>Вход для работников</h1>
<form method="post" class="card">
    @if (Model.Error != null) { <p class="error">@Model.Error</p> }
    <label>Логин <input asp-for="Username" /></label>
    <label>Пароль <input asp-for="Password" type="password" /></label>
    <button type="submit">Войти</button>
</form>
