@page "/{slug}"
@model Свинья_Визенау.Pages.Animals.DetailsModel
@{
    ViewData["Title"] = Model.Animal.Name;
}

<h1>@Model.Animal.Name</h1>

<div class="mb-3">
    <a href="https://zoostav.ru" target="_blank" rel="noopener"
       class="btn btn-outline-primary btn-sm">
        🏠 На главную страницу зоопарка Ставрополья
    </a>
</div>

<div class="row mt-4">
    <div class="col-md-6">

        @* ─── Галерея фото ─────────────────────────────────────── *@
        @if (Model.Animal.Photos.Any())
        {
            <div id="photoCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Animal.Photos.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#photoCarousel"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")"
                                aria-label="Фото @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner rounded shadow-sm">
                    @{ var orderedPhotos = Model.Animal.Photos.OrderBy(p => p.SortOrder).ToList(); }
                    @for (int i = 0; i < orderedPhotos.Count; i++)
                    {
                        var photo = orderedPhotos[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@photo.Url"
                                 class="d-block w-100"
                                 style="max-height: 400px; object-fit: cover;"
                                 alt="@(photo.Caption ?? Model.Animal.Name)" />
                            @if (!string.IsNullOrEmpty(photo.Caption))
                            {
                                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded">
                                    <p class="mb-0">@photo.Caption</p>
                                </div>
                            }
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button"
                        data-bs-target="#photoCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button"
                        data-bs-target="#photoCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.Animal.PhotoUrl))
        {
            @* fallback: если галерея пустая, показываем старое одиночное фото *@
            <img src="@Model.Animal.PhotoUrl"
                 alt="@Model.Animal.Name"
                 class="img-fluid rounded shadow-sm"
                 style="max-height: 400px; object-fit: cover;" />
        }
        @* ─── /Галерея фото ────────────────────────────────────── *@

        @if (!string.IsNullOrEmpty(Model.Animal.VideoUrl))
        {
            <video controls class="mt-3 w-100">
                <source src="@Model.Animal.VideoUrl" />
            </video>
        }

        @if (!string.IsNullOrEmpty(Model.Animal.WebcamUrl))
        {
            <div class="mt-3">
                <h5>Веб-камера</h5>
                <video controls autoplay muted loop
                       style="width: 100%; max-height: 400px; border-radius: 4px;">
                    <source src="@Model.Animal.WebcamUrl" type="video/mp4" />
                </video>
            </div>
        }
    </div>

    <div class="col-md-6">
        <p>@Model.Animal.Description</p>
        <p>
            <strong>В зоопарке с:</strong>
            @Model.Animal.ArrivedAt.ToString("dd.MM.yyyy")
        </p>
        <a href="https://pay.cloudtips.ru/p/c7a80e09" target="_blank" class="btn btn-success">Помочь животному</a>
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true &&
     (User.IsInRole("Worker") || User.IsInRole("Admin")))
{
    <hr />
    <h3>Дневник наблюдений</h3>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Тип</th>
                <th>Заметка</th>
                <th>Автор</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Animal.DiaryEntries.OrderByDescending(x => x.RecordedAt))
            {
                <tr>
                    <td>@e.RecordedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@e.Notes</td>
                    <td>@(e.RecordedBy?.DisplayName ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="/Diary/Index" class="btn btn-outline-primary">Редактировать дневник</a>
}

<p class="mt-4">
    <a asp-page="/Index" class="btn btn-secondary">← На главную</a>
</p>