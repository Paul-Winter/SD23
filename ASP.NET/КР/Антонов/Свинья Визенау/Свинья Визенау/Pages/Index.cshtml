@page
@model IndexModel
@{
    ViewData["Title"] = "Зоопарк";
}

<div class="text-center">
    <h1 class="display-4">Добро пожаловать в зоопарк!</h1>
    <p class="lead">Наш обитатель:</p>
</div>

<ul class="list-group mt-4">
    <li class="list-group-item">
        <a asp-page="/Animals/Details" asp-route-slug="wizenau">Поросёнок Визенау</a>
    </li>
</ul>
<hr class="mt-5" />
<div class="row mt-4">
    <div class="col-md-8 mx-auto text-center">
        <h3>О нашем зоопарке</h3>
        <p class="text-muted">
            Наш зоопарк — небольшой, но уютный дом для животных,
            попавших в трудную ситуацию. Мы заботимся о каждом обитателе,
            ведём дневники наблюдений и рады каждому посетителю.
        </p>
    </div>
</div>
