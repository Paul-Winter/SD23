@page
@model ZooStav.Wolf.Web.Pages.Staff.DeniedModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Доступ ограничен";
}

<h1>Доступ ограничен</h1>
<div class="alert alert-warn">
    Раздел доступен только авторизованным работникам зоопарка. Проверьте вход или обратитесь к администратору.
</div>

<h2>Правила доступа</h2>
<div class="table-wrap">
    <table>
        <thead>
        <tr><th>Роль</th><th>Что может</th></tr>
        </thead>
        <tbody>
        <tr>
            <td><b>Гость / посетитель</b></td>
            <td>Публичная страница животного: история особи, фото, видео, веб-камера, публичный дневник, донаты.</td>
        </tr>
        <tr>
            <td><b>Keeper (кипер)</b></td>
            <td>Чтение всего дневника (включая служебные записи), создание записей (кормёжка и др.),
                комментарии, правка собственных записей, журнал изменений.</td>
        </tr>
        <tr>
            <td><b>Veterinarian (ветеринар)</b></td>
            <td>Всё как у кипера + вакцинации, лечение, диагнозы; доступ к API журнала изменений.</td>
        </tr>
        <tr>
            <td><b>Admin (руководство)</b></td>
            <td>Полный доступ: удаление записей, правка любых записей, управление пользователями,
                обработка донатов, API <code>/api/staff/users</code>.</td>
        </tr>
        <tr>
            <td><b>Observer (наблюдатель/стажёр)</b></td>
            <td>Только чтение дневника, включая служебные записи. Без права вносить изменения.</td>
        </tr>
        </tbody>
    </table>
</div>

<p style="margin-top:16px">
    <a class="btn btn-ok" href="/staff/login">Войти</a>
    <a class="btn btn-ghost" href="/">На публичную страницу</a>
</p>
