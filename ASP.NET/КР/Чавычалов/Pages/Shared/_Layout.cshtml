<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] — Ставропольский зоопарк</title>
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
  <header class="top">
    <a class="brand" href="/">🦁 StavZoo</a>
    <nav>
      <a href="/">Животные</a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <span class="who">@User.Identity.Name</span>
        <form method="post" action="/Logout" class="inline"><button class="link">Выйти</button></form>
      }
      else
      {
        <a href="/Login">Вход для работников</a>
      }
    </nav>
  </header>
  <main>@RenderBody()</main>
  <footer>© StavZoo</footer>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
