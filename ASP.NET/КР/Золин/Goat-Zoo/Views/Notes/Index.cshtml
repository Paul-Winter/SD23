@{
    ViewData["Title"] = "Заметки";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — Камерунские козы</title>
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #fdf6ec;
                color: #3d2b1f;
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 900px;
                margin: 0 auto;
                padding: 20px;
            }

            h1 {
                color: #8b3e2f;
                text-align: center;
                border-bottom: 3px solid #e0a96d;
                padding-bottom: 10px;
            }

            .info-block {
                background-color: #fffaf3;
                border-radius: 12px;
                box-shadow: 0 4px 12px rgba(139, 62, 47, 0.15);
                padding: 25px;
                border-left: 5px solid #c96f4a;
            }

                .info-block p {
                    line-height: 1.7;
                }
    </style>
</head>
<body>
    <div class="container">
        <h1>📝 Мои заметки</h1>
        <div class="info-block">
            <p>Привет, <strong>@ViewBag.UserName</strong>! 🐐</p>
            <p>Здесь будут ваши заметки о камерунских козах.</p>
            <p><a href="/Account/Logout" style="color:#a0432f; font-weight:600;">Выйти</a></p>
        </div>
    </div>
</body>
</html>