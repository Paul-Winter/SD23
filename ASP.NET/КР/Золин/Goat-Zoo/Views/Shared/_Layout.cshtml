@functions {
    string IsActive(string controller, string action)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
    }
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Камерунские козы</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Goat_Zoo.styles.css" asp-append-version="true" />

    <style>
        /* ==================== Палитра проекта ==================== */
        :root {
            --goat-bg:            #fdf6ec;
            --goat-surface:       #fffaf3;
            --goat-surface-2:     #fbe8d3;
            --goat-accent:        #e0a96d;
            --goat-primary:       #c96f4a;
            --goat-primary-dark:  #8b3e2f;
            --goat-secondary:     #a0432f;
            --goat-text:          #3d2b1f;
            --goat-text-muted:    #8a6f5c;
            --goat-highlight:     #f7d9b6;
            --goat-shadow:        rgba(139, 62, 47, 0.15);
        }

        /* ==================== База ==================== */
        html {
            height: 100%;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--goat-bg);
            color: var(--goat-text);
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ==================== Шапка / навигация ==================== */
        .goat-header {
            background-color: var(--goat-surface);
            border-bottom: 3px solid var(--goat-accent);
            box-shadow: 0 4px 12px var(--goat-shadow);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .goat-navbar {
            padding: 0.7rem 0;
        }

        .goat-brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: var(--goat-primary-dark) !important;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .goat-brand:hover {
            color: var(--goat-primary) !important;
            transform: translateY(-1px);
        }

        .goat-brand__icon {
            font-size: 1.5rem;
            line-height: 1;
        }

        /* Пункты меню */
        .goat-nav .nav-link {
            color: var(--goat-text) !important;
            font-weight: 500;
            padding: 0.5rem 1rem;
            margin-right: 0.25rem;
            border-radius: 8px;
            border-bottom: 2px solid transparent;
            transition: background-color 0.2s ease, color 0.2s ease,
                        border-color 0.2s ease;
        }

        .goat-nav .nav-link:hover,
        .goat-nav .nav-link:focus {
            background-color: var(--goat-highlight);
            color: var(--goat-primary-dark) !important;
        }

        /* Активная страница */
        .goat-nav .nav-link.active {
            background-color: var(--goat-highlight);
            border-bottom-color: var(--goat-primary);
            color: var(--goat-primary-dark) !important;
            font-weight: 600;
        }

        /* Кнопка-бургер */
        .goat-toggler {
            border: 1px solid var(--goat-accent);
            border-radius: 8px;
            padding: 0.35rem 0.6rem;
        }

        .goat-toggler:focus {
            box-shadow: 0 0 0 0.2rem rgba(201, 111, 74, 0.3);
        }

        /* ==================== Кнопки ==================== */
        .btn-goat-outline,
        .btn-goat-primary {
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.45rem 1.15rem;
            transition: all 0.2s ease;
        }

        .btn-goat-outline {
            background-color: transparent;
            border: 1px solid var(--goat-primary);
            color: var(--goat-primary-dark);
        }

        .btn-goat-outline:hover,
        .btn-goat-outline:focus {
            background-color: var(--goat-highlight);
            border-color: var(--goat-primary);
            color: var(--goat-primary-dark);
        }

        .btn-goat-primary {
            background-color: var(--goat-primary);
            border: 1px solid var(--goat-primary);
            color: #fff;
        }

        .btn-goat-primary:hover,
        .btn-goat-primary:focus {
            background-color: var(--goat-primary-dark);
            border-color: var(--goat-primary-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(139, 62, 47, 0.25);
        }

        .btn-goat-outline:focus-visible,
        .btn-goat-primary:focus-visible {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(201, 111, 74, 0.35);
        }

        /* ==================== Контент ==================== */
        .goat-main {
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }

        /* ==================== Подвал ==================== */
        .goat-footer {
            flex-shrink: 0;
            background-color: var(--goat-surface);
            border-top: 3px solid var(--goat-accent);
            color: var(--goat-text-muted);
            font-size: 0.9rem;
            padding: 1.25rem 0;
            margin-top: 2rem;
        }

        .goat-footer a {
            color: var(--goat-secondary);
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .goat-footer a:hover {
            color: var(--goat-primary);
            text-decoration: underline;
        }

        /* ==================== Адаптив ==================== */
        @@media (max-width: 767.98px) {
            .goat-brand {
                font-size: 1.15rem;
            }

            .goat-nav .nav-link {
                padding: 0.55rem 0.75rem;
                margin-right: 0;
            }

            .goat-nav--auth {
                margin-top: 0.75rem;
                padding-top: 0.75rem;
                border-top: 1px dashed var(--goat-accent);
                gap: 0.5rem;
            }

            .goat-nav--auth .btn-goat-outline,
            .goat-nav--auth .btn-goat-primary {
                display: block;
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <header class="goat-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm goat-navbar">
            <div class="container">
                <a class="navbar-brand goat-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="goat-brand__icon">🐐</span>
                    <span>Камерунские козы</span>
                </a>

                <button class="navbar-toggler goat-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Основное меню -->
                    <ul class="navbar-nav flex-grow-1 goat-nav">
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Home", "Index")"
                               asp-area="" asp-controller="Home" asp-action="Index">Инфо</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Home", "Webcam")"
                               asp-area="" asp-controller="Home" asp-action="Webcam">Камера</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Home", "Donate")"
                               asp-area="" asp-controller="Home" asp-action="Donate">Донат</a>
                        </li>
                    </ul>

                    <!-- Кнопки справа -->
                    <ul class="navbar-nav goat-nav goat-nav--auth align-items-sm-center">
                        <li class="nav-item me-sm-2">
                            <a class="btn btn-goat-outline" asp-area="" asp-controller="Account" asp-action="Login">
                                Войти
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-goat-primary" asp-area="" asp-controller="Account" asp-action="Register">
                                Зарегистрироваться
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container goat-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="goat-footer">
        <div class="container">
            &copy; 2026 — Камерунские козы —
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Политика конфиденциальности</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>