@model Goat_Zoo.Models.User
@{
    ViewData["Title"] = "Регистрация";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Камерунские козы</title>
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #fdf6ec;
                color: #3d2b1f;
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 900px;
                margin: 0 auto;
                padding: 20px;
            }

            h1 {
                color: #8b3e2f;
                text-align: center;
                border-bottom: 3px solid #e0a96d;
                padding-bottom: 10px;
            }

            h2 {
                color: #a0432f;
                margin-top: 0;
            }

            .auth-block {
                background-color: #fffaf3;
                border-radius: 12px;
                box-shadow: 0 4px 12px rgba(139, 62, 47, 0.15);
                padding: 30px;
                margin-bottom: 30px;
                border-left: 5px solid #c96f4a;
                max-width: 520px;
                margin-left: auto;
                margin-right: auto;
            }

                .auth-block p {
                    line-height: 1.7;
                }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 6px;
                    font-weight: 600;
                    color: #6b2d1e;
                    font-size: 0.95em;
                }

            .form-control {
                width: 100%;
                box-sizing: border-box;
                padding: 10px 12px;
                border: 2px solid #e0a96d;
                border-radius: 8px;
                background-color: #fffaf3;
                color: #3d2b1f;
                font-size: 1em;
                font-family: inherit;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                .form-control:focus {
                    outline: none;
                    border-color: #c96f4a;
                    box-shadow: 0 0 0 3px rgba(201, 111, 74, 0.2);
                }

            .text-danger {
                color: #b23b2c;
                font-size: 0.85em;
                display: block;
                margin-top: 4px;
            }

            .btn-primary {
                background-color: #c96f4a;
                color: #fffaf3;
                border: none;
                border-radius: 8px;
                padding: 12px 24px;
                font-size: 1em;
                font-weight: 600;
                cursor: pointer;
                width: 100%;
                transition: background-color 0.2s, transform 0.1s;
                font-family: inherit;
            }

                .btn-primary:hover {
                    background-color: #8b3e2f;
                }

                .btn-primary:active {
                    transform: translateY(1px);
                }

            .form-footer {
                margin-top: 18px;
                text-align: center;
                font-size: 0.9em;
                color: #6b4a3a;
            }

                .form-footer a {
                    color: #a0432f;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .form-footer a:hover {
                        text-decoration: underline;
                    }

            .validation-summary {
                background-color: #fbe8d3;
                border-left: 4px solid #b23b2c;
                padding: 10px 15px;
                border-radius: 6px;
                margin-bottom: 18px;
                color: #6b2d1e;
                font-size: 0.9em;
            }

                .validation-summary ul {
                    margin: 0;
                    padding-left: 18px;
                }
    </style>
</head>
<body>
    <div class="container">
        <h1>🐐 Регистрация</h1>

        <div class="auth-block">
            <h2>Создать аккаунт</h2>
            <p>Заполните форму, чтобы присоединиться к сообществу любителей камерунских коз.</p>

            <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="validation-summary" asp-validation-summary="ModelOnly"></div>

                <div class="form-group">
                    <label asp-for="Login">Логин</label>
                    <input asp-for="Login" class="form-control" placeholder="Введите логин" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@mail.ru" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Пароль</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Минимум 6 символов" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary">Зарегистрироваться</button>

                <div class="form-footer">
                    Уже есть аккаунт? <a href="/Account/Login">Войти</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>