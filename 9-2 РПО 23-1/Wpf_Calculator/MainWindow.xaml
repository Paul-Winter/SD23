<Window x:Class="Wpf_Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="500"
        MinHeight="650"
        MinWidth="500">
    <Grid Background="#333333">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="63*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="83*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Bottom"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="7"
                    Grid.RowSpan="2"
                    Background="MediumPurple">
            <!--Прошлые операции-->
            <TextBox Margin="20,10,20,5"
                     FontSize="30"/>

            <!--Текущий ввод-->
            <TextBox Margin="10, 5"
                     FontSize="60"/>
        </StackPanel>

        <!--Первая колонка-->
        <Button Grid.Column="0" 
                Grid.Row="2"
                Margin="10,10,10,10" 
                Grid.ColumnSpan="2"
                Background="Black"
                Foreground="White"
                FontSize="25">Off
        </Button>
        <Button Grid.Column="0" 
            Grid.Row="3"
            Margin="10,10,10,10" 
            Grid.ColumnSpan="2"
            Background="Black"
            Foreground="White"
            FontSize="25">+/-
        </Button>
        <Button Grid.Column="0" 
            Grid.Row="4"
            Margin="10,10,10,10" 
            Grid.ColumnSpan="2"
            Background="Black"
            Foreground="White"
            FontSize="25">-->
        </Button>
        <Button Grid.Column="0" 
            Grid.Row="5"
            Margin="10,10,10,10" Grid.ColumnSpan="2"
            Background="#520099"
            Foreground="White"
            FontSize="25">CE/C
        </Button>
        <Button Grid.Column="0" 
            Grid.Row="6"
            Margin="10,10,10,10" Grid.ColumnSpan="2"
            Background="#520099"
            Foreground="White"
            FontSize="18">ON/AC
        </Button>

        <!--Вторая колонка-->
        <Button Grid.Column="2" 
            Grid.Row="2"
            Margin="10,10,5,10"
            Background="Black"
            Foreground="White"
            FontSize="25">MRC
        </Button>
        <Button Grid.Column="2" 
            Grid.Row="3"
            Margin="10,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">7
        </Button>
        <Button Grid.Column="2" 
            Grid.Row="4"
            Margin="10,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">4
        </Button>
        <Button Grid.Column="2" 
            Grid.Row="5"
            Margin="10,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">1
        </Button>
        <Button Grid.Column="2" 
            Grid.Row="6"
            Margin="10,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">0
        </Button>

        <!--Третья колонка-->
        <Button Grid.Column="3" 
            Grid.Row="2"
            Margin="5,10,5,10"
            Background="Black"
            Foreground="White"
            FontSize="25">М-
        </Button>
        <Button Grid.Column="3" 
            Grid.Row="3"
            Margin="5,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">8
        </Button>
        <Button Grid.Column="3" 
            Grid.Row="4"
            Margin="5,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">5
        </Button>
        <Button Grid.Column="3" 
            Grid.Row="5"
            Margin="5,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">2
        </Button>
        <Button Grid.Column="3" 
            Grid.Row="6"
            Margin="5,10,5,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">00
        </Button>

        <!--Четвёртая колонка-->
        <Button Grid.Column="4" 
            Grid.Row="2"
            Margin="5,10,10,10"
            Background="Black"
            Foreground="White"
            FontSize="25">М+
        </Button>
        <Button Grid.Column="4" 
            Grid.Row="3"
            Margin="5,10,10,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">9
        </Button>
        <Button Grid.Column="4" 
            Grid.Row="4"
            Margin="5,10,10,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">6
        </Button>
        <Button Grid.Column="4" 
            Grid.Row="5"
            Margin="5,10,10,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">3
        </Button>
        <Button Grid.Column="4" 
            Grid.Row="6"
            Margin="5,10,10,10"
            Background="#8b00ff"
            Foreground="White"
            FontSize="25">.
        </Button>

        <!--Пятая колонка-->
        <Button Grid.Column="5" 
            Grid.Row="2"
            Background="Black"
            Foreground="White"
            FontSize="25"
            Margin="10,10,5,10">&#8730;
        </Button>
        <Button Grid.Column="5" 
            Grid.Row="3"
            Margin="10,10,5,10"
            Background="Black"
            Foreground="White"
            FontSize="25">/
        </Button>
        <Button Grid.Column="5" 
            Grid.Row="4"
            Background="Black"
            Foreground="White"
            FontSize="25"
            Margin="10,10,5,10">X
        </Button>
        <Button Grid.Column="5" 
            Grid.Row="5"
            Margin="10, 10, 5, 10"
            Grid.RowSpan="2"
            Background="Black"
            Foreground="White"
            FontSize="25">+
        </Button>

        <!--Шестая колонка-->
        <Button Grid.Column="6" 
            Grid.Row="2"
            Background="Black"
            Foreground="White"
            FontSize="25"
            Margin="5,10,10,10">MU
        </Button>
        <Button Grid.Column="6" 
            Grid.Row="3"
            Margin="5,10,10,10"
            Background="Black"
            Foreground="White"
            FontSize="25">%
        </Button>
        <Button Grid.Column="6" 
            Grid.Row="4"
            Margin="5,10,10,10"
            Background="Black"
            Foreground="White"
            FontSize="25">-
        </Button>
        <Button Grid.Column="6" 
            Grid.Row="5"
            Margin="5, 10, 10, 10"
            Grid.RowSpan="2"
            Background="Black"
            Foreground="White"
            FontSize="25">=
        </Button>
    </Grid>
</Window>
