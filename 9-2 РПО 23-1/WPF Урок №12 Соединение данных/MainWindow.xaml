<Window x:Class="WPF_Урок__12_Соединение_данных.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Урок__12_Соединение_данных"
        mc:Ignorable="d"
        Title="Привязка данных к элементам управления" Height="450" Width="800">
    <StackPanel Orientation="Vertical"
                VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Run Text="Yesterday: "/>
            <Run FontWeight="Bold"
                 Text="{local:Today -1}"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Run Text="Today: "/>
            <Run FontWeight="Bold"
                 Text="{local:Today UpperCase=True}"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Run Text="Tomorrow: "/>
            <Run FontWeight="Bold"
                 Text="{local:Today 1}"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Run Text="а и б"/>
            <Run FontWeight="Bold"
                 Text="{local:Kopilca 2,4,-4}"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Run Text=""/>
            <Run FontWeight="Bold"
                 Text="{local:DateTime}"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Run Text="Информация о студенте: "/>
            <Run FontWeight="Bold"
                 Text="{local:Student}"/> 
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBox />
            <Run FontWeight="Bold"
                 Text="{local:TimeToDate DateTime='2025/06/19'}"/> 
        </TextBlock>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBox x:Name="textBoxInfo"
                     Height="22"
                     Width="150"></TextBox>
            <Button Click="Button_Click">Add student</Button>
            <Run Text="Информация о студенте: "/>
            <TextBlock x:Name="textBlock"
                       Text=""/>            
        </TextBlock>
        <ListBox x:Name="listBox"
                 Margin="5"  
                 Height="124"
                 Width="150">
            <!--<ListBoxItem Content="Alexandrova"/>
            <ListBoxItem Content="Antonov"/>
            <ListBoxItem Content="Dukhina"/>
            <ListBoxItem Content="Zemlyanskiy"/>
            <ListBoxItem Content="Zolin"/>
            <ListBoxItem Content="Krasitskiy"/>
            <ListBoxItem Content="Kubanov"/>
            <ListBoxItem Content="Lushnikov"/>
            <ListBoxItem Content="Mamontova"/>
            <ListBoxItem Content="Metelitcin"/>
            <ListBoxItem Content="Chavychalov"/>
            <ListBoxItem Content="Yunusov"/>-->
        </ListBox>
    </StackPanel>    
</Window>
