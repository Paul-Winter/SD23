<Window x:Class="WPF_Урок__10_Контейнеры.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Урок__10_Контейнеры"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <Button Margin="5,5,5,0">1</Button>
            <Button Margin="5,5,5,0" Width="100">2</Button>
            <Button Margin="5,5,5,0" MinWidth="100">3</Button>
            <Button Margin="5,5,5,0" MinWidth="100" Width="150">4</Button>
            <Button Margin="5,5,5,0" MaxWidth="100">5</Button>
            <Button Margin="5,5,5,0" MinWidth="150" Width="100">6</Button>
            <Button Margin="5,5,5,0" Width="150" MaxWidth="100">7</Button>
            <Button Margin="5,5,5,0" Width="100" MaxWidth="150">8</Button>
            <Button Margin="5,5,5,0" MinWidth="150" MaxWidth="200">9</Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Width="40" Margin="5,5,0,5">1</Button>
            <Button Width="40" Margin="5,5,0,5" Height="100">2</Button>
            <Button Width="40" Margin="5,5,0,5" MinHeight="100">3</Button>
            <Button Width="40" Margin="5,5,0,5" MinHeight="100" Height="150">4</Button>
            <Button Width="40" Margin="5,5,0,5" MaxHeight="100">5</Button>
            <Button Width="40" Margin="5,5,0,5" MinHeight="150" Height="100">6</Button>
            <Button Width="40" Margin="5,5,0,5" Height="150" MaxHeight="100">7</Button>
            <Button Width="40" Margin="5,5,0,5" Height="100" MaxHeight="150">8</Button>
            <Button Width="40" Margin="5,5,0,5" MinHeight="150" MaxHeight="200">9</Button>
        </StackPanel>
    </Grid>
</Window>
