<Window x:Class="WPF_Урок__11_Элементы_управления.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Урок__11_Элементы_управления"
        mc:Ignorable="d"
        Title="Элементы управления" Height="600" Width="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Fill"
                    Foreground="White"
                    FontSize="25"
                    Height="80"
                    Width="200"
                    HorizontalContentAlignment="Stretch"
                    Margin="10, 5"
                    Padding="10, 20, 30, 35"
                    Click="Button_Click">
            <Button.Background>
                <ImageBrush ImageSource="C:\Users\User\Pictures\city.bmp" Stretch="Fill"/>
            </Button.Background>
        </Button>
            <RepeatButton Content="None"
                          Foreground="White"
                          FontSize="25"
                          Height="80"
                          Width="150"
                          Margin="10, 5"
                          Click="Button_Click"
                          Interval="1500"
                          Delay="0">
                <RepeatButton.Background>
                    <ImageBrush ImageSource="C:\Users\User\Pictures\city.bmp" Stretch="None"/>
                </RepeatButton.Background>
            </RepeatButton>
            <Button Height="80"
                    Width="200"
                    Foreground="White"
                    FontSize="25"
                    Margin="5"
                    Content="Uniform">
                <Button.Background>
                    <ImageBrush ImageSource="C:\Users\User\Pictures\city.bmp" Stretch="Uniform"/>
                </Button.Background>
            </Button>
            <Button Height="80"
                    Width="200"
                    Foreground="White"
                    FontSize="25"
                    Margin="5"
                    Content="UniformToFill">
                <Button.Background>
                    <ImageBrush ImageSource="C:\Users\User\Pictures\city.bmp" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <CheckBox Checked="CheckBox_Checked"
                  IsChecked="False"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="10, 5">
                    Unchecked
                </CheckBox>
                <CheckBox Checked="CheckBox_Checked"
                  IsChecked="True"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="10, 5">
                    Checked
                </CheckBox>
                <CheckBox Checked="CheckBox_Checked"
                  IsChecked="{x:Null}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="10, 5">
                    Indeterminate
                </CheckBox>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <RadioButton Margin="5"
                             GroupName="left">
                    Option 1
                </RadioButton>
                <RadioButton Margin="5"
                             GroupName="left">
                    Option 2
                </RadioButton>
                <RadioButton Margin="5"
                             GroupName="left">
                    Option 3
                </RadioButton>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <RadioButton Margin="5"
                             GroupName="left">
                    Option 4
                </RadioButton>
                <RadioButton Margin="5"
                             GroupName="left">
                    Option 5
                </RadioButton>
                <RadioButton Margin="5"
                             GroupName="left">
                    Option 6
                </RadioButton>
            </StackPanel>
        </StackPanel>
        <TextBox TextAlignment="Justify"
                 TextWrapping="WrapWithOverflow"
                 Margin="10, 5"
                 Width="330">
            Какой-то контент
        </TextBox>
        <PasswordBox Width="330"
                     Margin="10, 5"
                     Password="qwerty">
        </PasswordBox>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Background="Green"
                Foreground="White">
                <StackPanel Orientation="Horizontal"
                        Margin="5">
                    <Button>
                        Ещё одна кнопка
                    </Button>
                    <TextBox Margin="10,0,0,0"
                         Width="100">
                        Какой-то текст
                    </TextBox>
                </StackPanel>
            </Button>
            <Button FontSize="25"
                Height="46"
                Width="150"
                Margin="5">OK
                <Button.Background>
                    <LinearGradientBrush EndPoint="1,1"
                                     StartPoint="0,0">
                        <GradientStop Color="Red" Offset="0"/>
                        <GradientStop Color="Green" Offset="0.5"/>
                        <GradientStop Color="Blue" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#FF777777" Offset="0.5"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Foreground>
            </Button>
            <Button Content="OK"
                FontSize="25"
                Foreground="Gray"
                Height="46"
                Width="150">
                <Button.Background>
                    <RadialGradientBrush GradientOrigin="0.5, 0.5">
                        <GradientStop Color="Red" Offset="0"/>
                        <GradientStop Color="Green" Offset="0.5"/>
                        <GradientStop Color="Blue" Offset="1"/>
                    </RadialGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
        <TextBlock FontStyle="Italic"
                   FontWeight="Bold"
                   Text="Какой-то текст перед картинкой">            
        </TextBlock>
        <Image Margin="10"
               Height="100"
               Width="150"
               HorizontalAlignment="Left"
               Source="C:\Users\User\Pictures\TOP-wallpaper.jpg">            
        </Image>
        <!--<MediaElement Source="C:\Users\User\Videos\sample-5s.mp4"/>-->
        <Border Background="Yellow"
                    BorderBrush="Green"
                    BorderThickness="5"
                    CornerRadius="10"
                    Margin="10">
            <Button Content="content inside border"
                    Height="46"
                    Background="#00000000"></Button>
        </Border>
        <StackPanel Orientation="Horizontal">
            <Label Target="{Binding ElementName=usertext}">
                _User Text
            </Label>
            <TextBox x:Name="usertext"
                     Width="200">               
            </TextBox>
        </StackPanel>
    </StackPanel>
</Window>
