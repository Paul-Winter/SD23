<Window x:Class="WPF_Урок__11_Элементы.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Урок__11_Элементы"
        mc:Ignorable="d"
        Title="Элементы управления" Height="600" Width="850">
    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center">
        <Menu IsMainMenu="True">
            <MenuItem Header="File">
                <MenuItem Header="Create"/>
                <MenuItem Header="Open"/>
                <MenuItem Header="Add"/>
                <MenuItem Header="Close"/>
                <MenuItem Header="Save"/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Copy"/>
                <MenuItem Header="Cut"/>
                <MenuItem Header="Paste"/>
                <MenuItem Header="Select All"/>
                <MenuItem Header="Delete"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Help"/>
                <MenuItem Header="FAQ"/>
                <MenuItem Header="What`s new?"/>
                <MenuItem Header="About Us"/>
                <MenuItem Header="Tech Support"/>
            </MenuItem>
        </Menu>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <GroupBox Header="Languages"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="150">
                <GroupBox.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="Red" Text="Red "/>
                        <TextBlock Foreground="Green" Text=" Green"/>
                        <TextBlock Foreground="Blue" Text=" Blue "/>
                        <Button Foreground="Purple"> OK</Button>
                    </StackPanel>
                </GroupBox.ToolTip>
            <StackPanel Orientation="Vertical"
                        Margin="5">
                <RadioButton Margin="5, 0">English</RadioButton>
                <RadioButton Margin="5, 0">Deutch</RadioButton>
                <RadioButton Margin="5, 0">Русский</RadioButton>
                <RadioButton Margin="5, 0">Spanish</RadioButton>
                <RadioButton Margin="5, 0">French</RadioButton>
            </StackPanel>
        </GroupBox>
            <Expander Header="Languages"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="150">
                <StackPanel Orientation="Vertical"
                            Margin="5">
                    <RadioButton Margin="5, 0">English</RadioButton>
                    <RadioButton Margin="5, 0">Deutch</RadioButton>
                    <RadioButton Margin="5, 0">Русский</RadioButton>
                    <RadioButton Margin="5, 0">Spanish</RadioButton>
                    <RadioButton Margin="5, 0">French</RadioButton>
                </StackPanel>
            </Expander>
            <ProgressBar Height="30"
                         Width="200"
                         Minimum="0"
                         Maximum="200"
                         Value="88"/>
            <Slider Height="30"
                    Width="200"
                    Minimum="0"
                    Maximum="200"
                    Value="123"
                    TickFrequency="10"
                    TickPlacement="BottomRight"
                    Ticks="0, 40, 80, 120, 160, 200"
                    IsSelectionRangeEnabled="True"
                    SelectionStart="25"
                    SelectionEnd="75"/>
            <ScrollBar Orientation="Vertical"
                   Maximum="30"
                   Value="10"/>
        </StackPanel>
        <ScrollBar Orientation="Horizontal"
                   Maximum="100"
                   Value="33"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <ListBox Height="100"
                     Width="200"
                     SelectionMode="Multiple"
                     VerticalAlignment="Top"
                     ToolTip="ListBox Tooltip">
                <ListBoxItem>English</ListBoxItem>
                <ListBoxItem>Deutch</ListBoxItem>
                <ListBoxItem IsSelected="True">Русский</ListBoxItem>
                <ListBoxItem>French</ListBoxItem>
                <ListBoxItem>Spanish</ListBoxItem>
            </ListBox>
            <ComboBox Height="26"
                      Width="200"
                      VerticalAlignment="Top">
                <ComboBoxItem>English</ComboBoxItem>
                <ComboBoxItem>Deutch</ComboBoxItem>
                <ComboBoxItem IsSelected="True">Русский</ComboBoxItem>
                <ComboBoxItem>French</ComboBoxItem>
                <ComboBoxItem>Spanish</ComboBoxItem>
            </ComboBox>
            <TreeView Width="200">
                <TreeViewItem Header="Европа">
                    <TreeViewItem Header="Ставропольский край">
                        <TreeViewItem Header="Ставрополь"/>
                        <TreeViewItem Header="Пятигорск"/>
                        <TreeViewItem Header="Кисловодск"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Ростовская область">
                        <TreeViewItem Header="Ростов-на-Дону"/>
                        <TreeViewItem Header="Аксай"/>
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="Азия">
                    <TreeViewItem Header="Челябинская область">
                        <TreeViewItem Header="Челябинск"/>
                        <TreeViewItem Header="Магнитогорск"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Алтайский край">
                        <TreeViewItem Header="Барнаул"/>
                        <TreeViewItem Header="Бийск"/>
                    </TreeViewItem>
                </TreeViewItem>
            </TreeView>
            <TabControl>
                <TabItem Header="Languages">
                    <ListBox Height="100"
                     Width="200"
                     SelectionMode="Multiple"
                     VerticalAlignment="Top">
                        <ListBoxItem>English</ListBoxItem>
                        <ListBoxItem>Deutch</ListBoxItem>
                        <ListBoxItem IsSelected="True">Русский</ListBoxItem>
                        <ListBoxItem>French</ListBoxItem>
                        <ListBoxItem>Spanish</ListBoxItem>
                    </ListBox>
                </TabItem>
                <TabItem Header="Cities">
                    <ListBox Height="100"
                     Width="200"
                     SelectionMode="Multiple"
                     VerticalAlignment="Top">
                        <ListBoxItem>Москва</ListBoxItem>
                        <ListBoxItem>Смоленск</ListBoxItem>
                        <ListBoxItem IsSelected="True">Ставрополь</ListBoxItem>
                        <ListBoxItem>Пятигорск</ListBoxItem>
                        <ListBoxItem>Грозный</ListBoxItem>
                    </ListBox>
                </TabItem>
            </TabControl>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Canvas Grid.Column="0"
                    Background="Green"
                    Margin="5, 10"
                    Width="150"
                    Height="150">
                <Border Background="Yellow"
                        Canvas.Left="20"
                        Canvas.Top="20"
                        Height="50"
                        Width="50">                    
                </Border>
                <Popup IsOpen="True">
                    <TextBlock Background="LightBlue"
                               Padding="5"
                               Text="Popup Text"/>
                </Popup>
            </Canvas>
            <Canvas Grid.Column="1"
                    Background="Red"
                    Margin="5, 10"
                    Width="150"
                    Height="150">
                <Border Background="Yellow"
                        Canvas.Left="20"
                        Canvas.Top="20"
                        Height="50"
                        Width="50">
                </Border>
                <Popup IsOpen="True"
                       PlacementRectangle="20,20,60,60">
                    <TextBlock Background="LightBlue"
                               Padding="5"
                               Text="Popup Text"/>
                </Popup>
            </Canvas>
        </Grid>
    </StackPanel>
</Window>
